sub-screenshot-benchmark:
	@test -d screenshot/ || mkdir -p screenshot/
	cd screenshot/ && ( test -e Makefile || $(QMAKE) -o Makefile /os_repos/company/it-talks/demos/qtdemos/widgets/desktop/screenshot/screenshot.pro ) && $(MAKE) -f Makefile benchmark
sub-systray-benchmark:
	@test -d systray/ || mkdir -p systray/
	cd systray/ && ( test -e Makefile || $(QMAKE) -o Makefile /os_repos/company/it-talks/demos/qtdemos/widgets/desktop/systray/systray.pro ) && $(MAKE) -f Makefile benchmark
benchmark: sub-screenshot-benchmark sub-systray-benchmark
install:install_subtargets  FORCE

