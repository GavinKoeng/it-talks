sub-screenshot-distdir: FORCE
	@test -d screenshot/ || mkdir -p screenshot/
	cd screenshot/ && ( test -e Makefile || $(QMAKE) -o Makefile /os_repos/company/it-talks/demos/qtdemos/widgets/desktop/screenshot/screenshot.pro ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/screenshot

sub-systray-distdir: FORCE
	@test -d systray/ || mkdir -p systray/
	cd systray/ && ( test -e Makefile || $(QMAKE) -o Makefile /os_repos/company/it-talks/demos/qtdemos/widgets/desktop/systray/systray.pro ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/systray

