####### Compile

main.o: main.cpp pathstroke.h \
		../shared/arthurwidgets.h \
		../shared/arthurstyle.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

pathstroke.o: pathstroke.cpp pathstroke.h \
		../shared/arthurwidgets.h \
		../shared/arthurstyle.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o pathstroke.o pathstroke.cpp

fbopaintdevice.o: ../shared/fbopaintdevice.cpp ../shared/fbopaintdevice.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o fbopaintdevice.o ../shared/fbopaintdevice.cpp

arthurstyle.o: ../shared/arthurstyle.cpp ../shared/arthurstyle.h \
		../shared/arthurwidgets.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o arthurstyle.o ../shared/arthurstyle.cpp

arthurwidgets.o: ../shared/arthurwidgets.cpp ../shared/arthurwidgets.h \
		../shared/arthurstyle.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o arthurwidgets.o ../shared/arthurwidgets.cpp

hoverpoints.o: ../shared/hoverpoints.cpp ../shared/arthurwidgets.h \
		../shared/arthurstyle.h \
		../shared/hoverpoints.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o hoverpoints.o ../shared/hoverpoints.cpp

qrc_shared.o: qrc_shared.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_shared.o qrc_shared.cpp

qrc_pathstroke.o: qrc_pathstroke.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_pathstroke.o qrc_pathstroke.cpp

moc_pathstroke.o: moc_pathstroke.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_pathstroke.o moc_pathstroke.cpp

moc_arthurwidgets.o: moc_arthurwidgets.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_arthurwidgets.o moc_arthurwidgets.cpp

moc_hoverpoints.o: moc_hoverpoints.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_hoverpoints.o moc_hoverpoints.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/painting/pathstroke || mkdir -p $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/painting/pathstroke
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/painting/pathstroke/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/painting/pathstroke/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/painting/pathstroke/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/painting/pathstroke/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

