####### Compile

locationdialog.o: locationdialog.cpp locationdialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o locationdialog.o locationdialog.cpp

main.o: main.cpp mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

mainwindow.o: mainwindow.cpp locationdialog.h \
		mainwindow.h \
		settingstree.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o mainwindow.cpp

settingstree.o: settingstree.cpp settingstree.h \
		variantdelegate.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o settingstree.o settingstree.cpp

variantdelegate.o: variantdelegate.cpp variantdelegate.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o variantdelegate.o variantdelegate.cpp

moc_locationdialog.o: moc_locationdialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_locationdialog.o moc_locationdialog.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_settingstree.o: moc_settingstree.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_settingstree.o moc_settingstree.cpp

moc_variantdelegate.o: moc_variantdelegate.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_variantdelegate.o moc_variantdelegate.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/tools/settingseditor || mkdir -p $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/tools/settingseditor
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/tools/settingseditor/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/tools/settingseditor/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/tools/settingseditor/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/tools/settingseditor/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

