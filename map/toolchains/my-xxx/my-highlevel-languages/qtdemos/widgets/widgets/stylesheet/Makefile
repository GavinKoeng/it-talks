####### Compile

main.o: main.cpp mainwindow.h \
		ui_mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

mainwindow.o: mainwindow.cpp mainwindow.h \
		ui_mainwindow.h \
		stylesheeteditor.h \
		ui_stylesheeteditor.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o mainwindow.cpp

stylesheeteditor.o: stylesheeteditor.cpp stylesheeteditor.h \
		ui_stylesheeteditor.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o stylesheeteditor.o stylesheeteditor.cpp

qrc_stylesheet.o: qrc_stylesheet.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_stylesheet.o qrc_stylesheet.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_stylesheeteditor.o: moc_stylesheeteditor.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_stylesheeteditor.o moc_stylesheeteditor.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/widgets/stylesheet || mkdir -p $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/widgets/stylesheet
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/widgets/stylesheet/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/widgets/stylesheet/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/widgets/stylesheet/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/widgets/stylesheet/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

