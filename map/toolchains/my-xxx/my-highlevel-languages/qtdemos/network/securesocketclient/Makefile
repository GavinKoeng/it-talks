####### Compile

certificateinfo.o: certificateinfo.cpp certificateinfo.h \
		ui_certificateinfo.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o certificateinfo.o certificateinfo.cpp

main.o: main.cpp sslclient.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

sslclient.o: sslclient.cpp certificateinfo.h \
		sslclient.h \
		ui_sslclient.h \
		ui_sslerrors.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o sslclient.o sslclient.cpp

qrc_securesocketclient.o: qrc_securesocketclient.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_securesocketclient.o qrc_securesocketclient.cpp

moc_certificateinfo.o: moc_certificateinfo.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_certificateinfo.o moc_certificateinfo.cpp

moc_sslclient.o: moc_sslclient.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_sslclient.o moc_sslclient.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/network/securesocketclient || mkdir -p $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/network/securesocketclient
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/network/securesocketclient/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/network/securesocketclient/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/network/securesocketclient/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/network/securesocketclient/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

