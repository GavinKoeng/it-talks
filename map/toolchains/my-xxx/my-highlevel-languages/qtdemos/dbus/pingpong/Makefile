sub-ping-pro-distdir: FORCE
	( test -e Makefile.ping || $(QMAKE) -o Makefile.ping /os_repos/company/it-talks/demos/qtdemos/dbus/pingpong/ping.pro ) && $(MAKE) -e -f Makefile.ping distdir DISTDIR=$(DISTDIR)/

sub-pong-pro-distdir: FORCE
	( test -e Makefile.pong || $(QMAKE) -o Makefile.pong /os_repos/company/it-talks/demos/qtdemos/dbus/pingpong/pong.pro ) && $(MAKE) -e -f Makefile.pong distdir DISTDIR=$(DISTDIR)/

