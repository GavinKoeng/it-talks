	( test -e Makefile.complexping || $(QMAKE) -o Makefile.complexping /os_repos/company/it-talks/demos/qtdemos/dbus/complexpingpong/complexping.pro ) && $(MAKE) -e -f Makefile.complexping distdir DISTDIR=$(DISTDIR)/

