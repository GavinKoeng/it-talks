详细介绍以下两个文件的作用和关联，并给出可能的bug

jsroute文件：

#!/usr/bin/env node

var express = require('express')
var child = require('child_process')
var app = express()
var mutipart= require('connect-multiparty');
var mutipartMiddeware = mutipart();

app.set('tmpdir', './tmp')
app.set('port',process.env.PORT || 3000)

child.exec('mkdir -p ' + app.get('tmpdir'),
        function(err, out) {
          console.log(out)
        })
app.use(mutipart({uploadDir:app.get('tmpdir')}))

function local_chkparam (param) {
  if (!param) return false;
  if (JSON.stringify(param) === '{}') return false;
  if (JSON.stringify(param) === '[]') return false;
  return true;
}

function local_echo_fail(res, info) {
  console.log(info)
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.status(200).send(info)
}

function local_cmd_process(res, cmd) {
  console.log(cmd)
  child.exec(cmd, function(err, out) {
    console.log('stdout: ' + out)
    console.log('stderr: ' + err)
    res.setHeader('Access-Control-Allow-Origin', '*');
    res.status(200).send(err != null ? err : out)
  })
}

app.get('/',
        function (req, res) {
          let param = req.query
          if (!local_chkparam(param) || !local_chkparam(param.cmd)) {
            local_echo_fail(res, 'invalid parameters')
            return
          }
          local_cmd_process(res, param.cmd)
        })
app.get('/work',
        function (req, res) {
          let param = req.query
          console.log("get request ...")
          res.setHeader('Access-Control-Allow-Origin', '*');
          res.type('text/html');
          res.sendFile(__dirname + '/public/index.html')
        })
app.post('/upload', mutipartMiddeware,
        function (req, res) {
          let param = req.body
          let cmd
          let load = req.files.fileToUpload

          if (local_chkparam(param) && local_chkparam(param.cmd)) {
            console.log(load)
            cmd = param.cmd + ' "' + load.originalFilename
                            + '" "' + load.path + '"'
            local_cmd_process(res, cmd)
          } else {
            child.exec('rm -rf "' + load.path + '"')
            local_echo_fail(res, 'invalid parameters')
          }
        })

app.listen(app.get('port'),function () {
  console.log("Express started on port: " + app.get('port'));
})


public/index.html文件：

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Title</title>
</head>
<body>
    <div>
        <a href='http://www.itskywalker.com/data/语言.ppt'>Download file</a>
    </div>
    <form id="form"  enctype="multipart/form-data">
        <input type="file" name="fileToUpload" id="fileToUpload" onchange="fileSelected()">
        <input type="button" onclick="uploadFile()" style="display:none;" value="">
        <div id="fileName"></div>
        <div id="fileSize"></div>
        <div id="fileType"></div>
        <div id="progressNumber"></div>
    </form>
    <script>
        function fileSelected() {
            var file = document.getElementById('fileToUpload').files[0];
            if (file) {
                var fileSize = 0;
                if (file.size > 1024 * 1024)
                    fileSize = (Math.round(file.size * 100 / (1024 * 1024)) / 100).toString() + 'MB';
                else
                    fileSize = (Math.round(file.size * 100 / 1024) / 100).toString() + 'KB';
                document.getElementById('fileName').innerHTML = '名称: ' + file.name;
                document.getElementById('fileSize').innerHTML = '大小: ' + fileSize;
                document.getElementById('fileType').innerHTML = '类型: ' + file.type;
                uploadFile();
            }
        }
        function uploadFile() {
            var fd = new FormData();
            fd.append("fileToUpload", document.getElementById('fileToUpload').files[0]);
            fd.append("cmd", 'common/srvapp_uploadfile tmp');
            var xhr = new XMLHttpRequest();
            xhr.upload.addEventListener("progress", uploadProgress, false);
            xhr.addEventListener("load", uploadComplete, false);
            xhr.addEventListener("error", uploadFailed, false);
            xhr.addEventListener("abort", uploadCanceled, false);
            xhr.open("POST", 'http://' + location.host + '/upload');//修改成自己的接口
            xhr.send(fd);
        }
        function uploadProgress(evt) {
            if (evt.lengthComputable) {
                var percentComplete = Math.round(evt.loaded * 100 / evt.total);
                document.getElementById('progressNumber').innerHTML = percentComplete.toString() + '%';
            }
            else {
                document.getElementById('progressNumber').innerHTML = 'unable to compute';
            }
        }
        function uploadComplete(evt) {
            alert(evt.target.responseText);
        }
        function uploadFailed(evt) {
            alert("There was an error attempting to upload the file.");
        }
        function uploadCanceled(evt) {
            alert("The upload has been canceled by the user or the browser dropped the connection.");
        }
    </script>
</body>
</html>
