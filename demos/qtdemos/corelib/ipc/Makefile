sub-sharedmemory-check:
	@test -d sharedmemory/ || mkdir -p sharedmemory/
	cd sharedmemory/ && ( test -e Makefile || $(QMAKE) -o Makefile /os_repos/company/it-talks/demos/qtdemos/corelib/ipc/sharedmemory/sharedmemory.pro ) && $(MAKE) -f Makefile check
