sub-corelib-distdir: FORCE
	@test -d corelib/ || mkdir -p corelib/
	cd corelib/ && ( test -e Makefile || $(QMAKE) -o Makefile /os_repos/company/it-talks/demos/qtdemos/corelib/corelib.pro ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/corelib

