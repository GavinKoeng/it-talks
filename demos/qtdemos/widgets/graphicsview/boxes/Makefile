####### Compile

fbm.o: 3rdparty/fbm.c 3rdparty/fbm.h
	$(CC) -c $(CFLAGS) $(INCPATH) -o fbm.o 3rdparty/fbm.c

glbuffers.o: glbuffers.cpp glbuffers.h \
		glextensions.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o glbuffers.o glbuffers.cpp

glextensions.o: glextensions.cpp glextensions.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o glextensions.o glextensions.cpp

main.o: main.cpp glextensions.h \
		scene.h \
		glbuffers.h \
		gltrianglemesh.h \
		qtbox.h \
		roundedbox.h \
		trackball.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

qtbox.o: qtbox.cpp qtbox.h \
		glbuffers.h \
		glextensions.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qtbox.o qtbox.cpp

roundedbox.o: roundedbox.cpp roundedbox.h \
		glbuffers.h \
		glextensions.h \
		gltrianglemesh.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o roundedbox.o roundedbox.cpp

scene.o: scene.cpp scene.h \
		glbuffers.h \
		glextensions.h \
		gltrianglemesh.h \
		qtbox.h \
		roundedbox.h \
		trackball.h \
		3rdparty/fbm.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o scene.o scene.cpp

trackball.o: trackball.cpp trackball.h \
		scene.h \
		glbuffers.h \
		glextensions.h \
		gltrianglemesh.h \
		qtbox.h \
		roundedbox.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o trackball.o trackball.cpp

qrc_boxes.o: qrc_boxes.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_boxes.o qrc_boxes.cpp

moc_scene.o: moc_scene.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_scene.o moc_scene.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/graphicsview/boxes || mkdir -p $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/graphicsview/boxes
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/graphicsview/boxes/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/graphicsview/boxes/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/graphicsview/boxes/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/widgets/graphicsview/boxes/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

