	cd part7/ && ( test -e Makefile || $(QMAKE) -o Makefile /os_repos/company/it-talks/demos/qtdemos/widgets/tutorials/addressbook/part7/part7.pro ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/part7

