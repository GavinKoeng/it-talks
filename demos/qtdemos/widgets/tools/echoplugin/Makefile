sub-echowindow-distdir: FORCE
	@test -d echowindow/ || mkdir -p echowindow/
	cd echowindow/ && ( test -e Makefile || $(QMAKE) -o Makefile /os_repos/company/it-talks/demos/qtdemos/widgets/tools/echoplugin/echowindow/echowindow.pro ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/echowindow

sub-plugin-distdir: FORCE
	@test -d plugin/ || mkdir -p plugin/
	cd plugin/ && ( test -e Makefile || $(QMAKE) -o Makefile /os_repos/company/it-talks/demos/qtdemos/widgets/tools/echoplugin/plugin/plugin.pro ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/plugin

