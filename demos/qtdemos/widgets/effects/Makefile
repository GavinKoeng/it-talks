sub-blurpicker-distdir: FORCE
	@test -d blurpicker/ || mkdir -p blurpicker/
	cd blurpicker/ && ( test -e Makefile || $(QMAKE) -o Makefile /os_repos/company/it-talks/demos/qtdemos/widgets/effects/blurpicker/blurpicker.pro ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/blurpicker

