	@test -d fademessage/ || mkdir -p fademessage/
	cd fademessage/ && ( test -e Makefile || $(QMAKE) -o Makefile /os_repos/company/it-talks/demos/qtdemos/widgets/effects/fademessage/fademessage.pro ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/fademessage

