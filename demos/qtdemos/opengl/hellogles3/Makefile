####### Compile

glwindow.o: glwindow.cpp glwindow.h \
		../hellogl2/logo.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o glwindow.o glwindow.cpp

main.o: main.cpp glwindow.h \
		../hellogl2/logo.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

logo.o: ../hellogl2/logo.cpp ../hellogl2/logo.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o logo.o ../hellogl2/logo.cpp

qrc_hellogles3.o: qrc_hellogles3.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_hellogles3.o qrc_hellogles3.cpp

moc_glwindow.o: moc_glwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_glwindow.o moc_glwindow.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/opengl/hellogles3 || mkdir -p $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/opengl/hellogles3
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/opengl/hellogles3/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/opengl/hellogles3/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/opengl/hellogles3/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/lib/x86_64-linux-gnu/qt5/examples/opengl/hellogles3/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

